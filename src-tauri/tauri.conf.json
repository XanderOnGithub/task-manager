{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moss",
  "version": "0.1.7",
  "identifier": "com.xanderreyes.moss",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Moss",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 },
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "macos-fps": {
      "enabled": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNDlEQUEyMjU1RkFFOEQKUldTTnJsOGxvdHBKUUIvVFhORVdxSFF4UFVQbkxWWFYxZGlWVG1NWHFweW5sRjB3bDNDZit2eHMK",
      "endpoints": ["https://github.com/XanderOnGithub/task-manager/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
